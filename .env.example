# Рядок підключення до PostgreSQL (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Довгий випадковий рядок: openssl rand -base64 32
NEXTAUTH_SECRET="замінити_на_випадковий_рядок"

# Адреса сайту (локально так, на Vercel — твій домен)
NEXTAUTH_URL="http://localhost:3000"

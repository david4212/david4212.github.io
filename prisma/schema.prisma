generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subject {
  UKRAINIAN
  MATH
  HISTORY
  ENGLISH
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  flashcards   Flashcard[]
  testResults  TestResult[]
}

model Topic {
  id          String       @id @default(cuid())
  subject     Subject
  title       String
  order       Int          @default(0)
  flashcards  Flashcard[]
  subtopics   Subtopic[]
  questions   Question[]
  testResults TestResult[]

  @@index([subject, order])
}

// Підрозділ теми (необов'язковий): Предмет → Тема → Підрозділ → Питання/Картка
model Subtopic {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions   Question[]
  flashcards  Flashcard[]
  testResults TestResult[]

  @@index([topicId, order])
}

// Питання тесту: 2-5 варіантів, correctIndex — номер правильного (з нуля)
model Question {
  id           String   @id @default(cuid())
  text         String
  options      String[]
  correctIndex Int
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId   String?
  subtopic     Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([topicId])
  @@index([subtopicId])
}

// Флеш-картка: question = лицьова сторона (термін), answer = зворотна (пояснення)
model Flashcard {
  id        String   @id @default(cuid())
  question  String
  answer    String
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId String?
  subtopic  Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
  @@index([subtopicId])
}

// Результат проходження тесту (percent = correct / total * 100)
model TestResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId String?
  subtopic  Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  correct   Int
  total     Int
  percent   Int
  createdAt DateTime @default(now())

  @@index([userId, topicId])
}

// Стан діалогу адміна з ботом (бо serverless не пам'ятає між запитами)
model BotSession {
  chatId    String   @id
  mode      String
  step      String
  subject   Subject?
  topicId   String?
  subtopicId String?
  updatedAt DateTime @updatedAt
}

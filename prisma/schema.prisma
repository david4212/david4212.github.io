generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subject {
  UKRAINIAN
  MATH
  HISTORY
  ENGLISH
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  lastSeenAt   DateTime?
  flashcards   Flashcard[]
  testResults  TestResult[]
  examAttempts ExamAttempt[]

  // Daily Streak (дата активності — рядок YYYY-MM-DD за київським часом)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String?

  answers      UserAnswer[]
  errors       UserError[]
  testSessions TestSession[]
}

model Topic {
  id          String       @id @default(cuid())
  subject     Subject
  title       String
  order       Int          @default(0)
  subtopics   Subtopic[]
  flashcards  Flashcard[]
  questions   Question[]
  testResults TestResult[]

  @@index([subject, order])
}

// Підрозділ теми (необов'язковий): Предмет → Тема → Підрозділ → Питання/Картка
model Subtopic {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions   Question[]
  flashcards  Flashcard[]
  testResults TestResult[]

  @@index([topicId, order])
}

// Питання тесту. testLevel: 1 = Базовий, 2 = Середній, 3 = Поглиблений
model Question {
  id           String    @id @default(cuid())
  text         String
  options      String[]
  correctIndex Int
  imageUrl     String?
  explanation  String?
  testLevel    Int       @default(1)
  topicId      String
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId   String?
  subtopic     Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  answers      UserAnswer[]
  errors       UserError[]

  @@index([topicId])
  @@index([topicId, testLevel])
  @@index([subtopicId])
  @@index([createdAt])
}

// Флеш-картка: question = лицьова сторона (термін), answer = зворотна (пояснення)
model Flashcard {
  id         String    @id @default(cuid())
  question   String
  answer     String
  imageUrl   String?
  topicId    String
  topic      Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId String?
  subtopic   Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([topicId])
  @@index([subtopicId])
}

// Результат тесту. testLevel 1-3 = тест теми; 0 = практика по підрозділу
model TestResult {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicId String?
  subtopic   Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  testLevel  Int       @default(1)
  correct    Int
  total      Int
  percent    Int
  createdAt  DateTime  @default(now())

  @@index([userId, topicId])
}

// Фото, завантажені через бота (зберігаємо в базі, віддаємо через /api/img/<id>)
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// Тижневе пробне НМТ
model WeeklyExam {
  id          String         @id @default(cuid())
  title       String
  description String?
  isActive    Boolean        @default(true)
  startTime   DateTime       @default(now())
  endTime     DateTime
  createdAt   DateTime       @default(now())
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
}

model ExamQuestion {
  id           String     @id @default(cuid())
  examId       String
  exam         WeeklyExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  text         String
  options      String[]
  correctIndex Int
  imageUrl     String?
  subject      Subject?
  createdAt    DateTime   @default(now())

  @@index([examId])
}

model ExamAttempt {
  id        String     @id @default(cuid())
  examId    String
  exam      WeeklyExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  correct   Int
  total     Int
  percent  Int
  score     Int
  createdAt DateTime   @default(now())

  @@index([examId, userId])
}

// Стан діалогу адміна з ботом (serverless не пам'ятає між запитами)
model BotSession {
  chatId       String   @id
  mode         String
  step         String
  subject      Subject?
  topicId      String?
  subtopicId   String?
  testLevel    Int      @default(1)
  examId       String?
  pendingImage String?
  updatedAt    DateTime @updatedAt
}

// ───────── Розширення: банк помилок, діагностика, streak, питання дня ─────────

// Кожна відповідь користувача (для аналітики та "Питання-пастки")
// source: TEST | ERRORS | DIAGNOSTIC | SIMULATION | DAILY
model UserAnswer {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosen     Int?
  isCorrect  Boolean
  source     String   @default("TEST")
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([questionId, isCorrect])
  @@index([sessionId])
}

// Банк помилок (Spaced Repetition): закривається після 3 поспіль правильних у РІЗНИХ сесіях
model UserError {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  failCount          Int      @default(1)
  consecutiveCorrect Int      @default(0)
  isResolved         Boolean  @default(false)
  lastSessionId      String?
  lastAnswerAt       DateTime @default(now())
  createdAt          DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId, isResolved])
  @@index([questionId])
}

// Діагностичний тест / симуляція НМТ: збирається на льоту, зберігає проміжний стан
// kind: DIAGNOSTIC | SIMULATION; status: IN_PROGRESS | FINISHED
model TestSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  status      String    @default("IN_PROGRESS")
  questionIds String[]
  answers     Json      @default("{}")
  currentIdx  Int       @default(0)
  startedAt   DateTime  @default(now())
  deadlineAt  DateTime?
  finishedAt  DateTime?
  correct     Int?
  total       Int?
  percent     Int?
  updatedAt   DateTime  @updatedAt

  @@index([userId, kind, status])
  @@index([userId, startedAt])
}

// Питання дня (одне на календарну дату YYYY-MM-DD, київський час)
model DailyQuestion {
  id         String   @id @default(cuid())
  date       String   @unique
  questionId String
  createdAt  DateTime @default(now())
}
